@model IEnumerable<HelpdeskSystem.Models.Notification>
@using HelpdeskSystem.Models

@{
    var unreadCount = Model.Count(n => !n.IsRead);
    var readCount = Model.Count(n => n.IsRead);
    var totalCount = Model.Count();
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                    <div>
                        <h3 class="mb-1 text-primary fw-bold">🔔 Notifications</h3>
                        <p class="text-muted mb-0">Manage and review system notifications efficiently.</p>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <div class="badge bg-light text-dark border px-3 py-2">
                            Total Notification: <strong>@totalCount</strong>
                        </div>
                        <div class="badge bg-warning text-dark px-3 py-2">
                            Unread: <strong>@unreadCount</strong>
                        </div>
                        <div class="badge bg-success px-3 py-2">
                            Read: <strong>@readCount</strong>
                        </div>

                        <form asp-action="MarkAllAsRead" method="post" class="d-inline">
                            <button type="submit" class="btn btn-primary btn-sm">
                                Mark All as Read
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table id="notificationsTable" class="table table-striped table-bordered custom-datatable">
                    <thead class="table-light">
                        <tr>
                            <th style="min-width: 320px;">Message</th>
                            <th style="min-width: 160px;">Date</th>
                            <th style="width: 120px;">Status</th>
                            <th class="text-end" style="width: 220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var n in Model)
                        {
                            <tr class="@(n.IsRead ? "" : "table-warning-subtle")">
                                <td>
                                    <div class="fw-medium">@n.Message</div>

                                    @if (n.RelatedTicketId.HasValue)
                                    {
                                        <div class="mt-2">
                                            <a asp-controller="Tickets"
                                               asp-action="Details"
                                               asp-route-id="@n.RelatedTicketId"
                                               class="btn btn-outline-info btn-sm">
                                                View Request
                                            </a>
                                        </div>
                                    }
                                </td>

                                <td>
                                    <div class="small text-muted">
                                        @n.CreatedAt.ToLocalTime().ToString("g")
                                    </div>
                                </td>

                                <td>
                                    <span class="badge rounded-pill @(n.IsRead ? "bg-success" : "bg-warning text-dark")">
                                        @(n.IsRead ? "Read" : "Unread")
                                    </span>
                                </td>

                                <td class="text-end">
                                    <div class="d-flex justify-content-end flex-wrap gap-2">
                                        @if (!n.IsRead)
                                        {
                                            <form asp-action="MarkAsRead" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@n.Id" />
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    Mark Read
                                                </button>
                                            </form>
                                        }

                                        <form asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this notification?');">
                                            <input type="hidden" name="id" value="@n.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-home"></i>
                Back to Home
            </a>
        </div>
    </div>
</div>

