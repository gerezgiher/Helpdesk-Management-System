@model IEnumerable<HelpdeskSystem.Models.Priority>

<h2 class="text-center mb-4 text-primary">Priorities List</h2>

<div class="mb-3 text-end">
    <a asp-action="Create" class="btn btn-success">+ New Urgency</a>
</div>

<table id="prioritiesTable" class="table table-striped table-bordered custom-datatable">
    <thead>
        <tr>
            <th>Priority Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var priority in Model)
        {
            <tr>
                <td>@priority.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@priority.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Details" asp-route-id="@priority.Id" class="btn btn-sm btn-outline-info">
                        <i class="bi bi-eyeb tn-outline"></i> Details
                    </a>
                    <form asp-action="Delete" asp-route-id="@priority.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Are you sure you want to delete this priority?');">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>


