@model HelpdeskSystem.Models.Priority

@{
    var isEdit = ViewData["Title"]?.ToString().Contains("Edit") ?? false;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="row">
    <div class="col-md-12">
        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Priority Panel -->
            <div class="panel panel-default mb-4 border rounded shadow-sm">
                <div class="panel-heading bg-light p-3 border-bottom rounded-top text-center">
                    <h4 class="panel-title fw-bold text-darkcyan">
                        @(isEdit ? "Edit Priority" : "Create Priority")
                    </h4>
                </div>

                <div class="panel-body p-4">
                    <div class="row">
                        <!-- Single Column -->
                        <div class="col-md-6">

                            <!-- Priority Name -->
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label asp-for="Name" class="control-label fw-bold mb-0 me-3" style="min-width:120px;"></label>
                                    <input asp-for="Name" class="form-control" />
                                </div>
                                <div style="margin-left:120px;">
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- Buttons -->
            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary px-4 me-2">
                    @(isEdit ? "Update" : "Save")
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="fas fa-arrow-left me-2"></i>Back to List
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .form-control {
            width: 100% !important;
        }

        .field-validation-error {
            display: block;
            margin-top: 5px;
        }
    </style>
}
