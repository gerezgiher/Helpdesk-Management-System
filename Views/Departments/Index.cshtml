@model IEnumerable<HelpdeskSystem.Models.Department>

@using HelpdeskSystem.Models


<h2 class="text-center mb-4 text-primary">Departments List</h2>

<div class="mb-3 text-end">
    <a asp-action="Create" class="btn btn-success">+ New Department</a>
</div>

<table id="departmentsTable" class="table table-striped table-bordered custom-datatable">
    <thead>
        <tr>
            <th>Department Code</th>
            <th>Department Name</th>
            <th>Location</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var department in Model)
        {
            <tr>
                <td>@department.DepartmentCode</td>
                <td>@department.DepartmentName</td>
                <td>@department.Location</td>
                <td>
                    <form asp-action="ToggleStatus"
                          asp-controller="Departments"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@department.Id" />

                        <button type="submit"
                                class="btn btn-sm @(department.AvailabilityStatus == AvailabilityStatus.Active
                            ? "btn-success"
                            : "btn-danger")">
                            @department.AvailabilityStatus
                        </button>
                    </form>
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@department.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Details" asp-route-id="@department.Id" class="btn btn-sm btn-outline-info">
                        <i class="bi bi-eyeb tn-outline"></i> Details
                    </a>
                    <form asp-action="Delete" asp-route-id="@department.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Are you sure you want to delete this department?');">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

