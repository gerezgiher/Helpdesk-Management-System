@model HelpdeskSystem.Models.Department

@{
    var isEdit = ViewData["Title"]?.ToString().Contains("Edit") ?? false;
    // ViewData["Title"] = isEdit ? "Edit Department" : "Create Department";
}

@* <h2 class="text-center mb-4">@ViewData["Title"]</h2> *@

@* @if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
} *@

<div class="row">
    <div class="col-md-12">
        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Department Panel -->
            <div class="panel panel-default mb-4 border rounded shadow-sm">
                <div class="panel-heading bg-light p-3 border-bottom rounded-top text-center">
                    <h4 class="panel-title fw-bold text-darkcyan">
                        @(isEdit ? "Edit Department" : "Create Department")
                    </h4>
                </div>

                <div class="panel-body p-4">
                    <div class="row">

                        <!-- Left Column -->
                        <div class="col-md-6">

                            <!-- Department Code -->
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label asp-for="DepartmentCode" class="control-label fw-bold mb-0 me-3" style="min-width:120px;"></label>
                                    <input asp-for="DepartmentCode" class="form-control" />
                                </div>
                                <div style="margin-left:120px;">
                                    <span asp-validation-for="DepartmentCode" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Department Name -->
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label asp-for="DepartmentName" class="control-label fw-bold mb-0 me-3" style="min-width:120px;"></label>
                                    <input asp-for="DepartmentName" class="form-control" />
                                </div>
                                <div style="margin-left:120px;">
                                    <span asp-validation-for="DepartmentName" class="text-danger"></span>
                                </div>
                            </div>

                        </div>

                        <!-- Right Column -->
                        <div class="col-md-6">

                            <!-- Location -->
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label asp-for="Location" class="control-label fw-bold mb-0 me-3" style="min-width:120px;"></label>
                                    <input asp-for="Location" class="form-control" />
                                </div>
                                <div style="margin-left:120px;">
                                    <span asp-validation-for="Location" class="text-danger"></span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- Buttons -->
            <!-- Buttons -->
            <div class="form-group text-center mt-4">
            <div class="form-group">
                <button type="submit" class="btn btn-primary px-4 me-2">Update</button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="fas fa-arrow-left me-2"></i>Back to List
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .form-control {
            width: 100% !important;
        }

        .field-validation-error {
            display: block;
            margin-top: 5px;
        }

        select.form-control {
            height: 38px;
        }
    </style>
}
