@using Microsoft.AspNetCore.Identity
@using HelpdeskSystem.Data
@using HelpdeskSystem.Models
@using Microsoft.EntityFrameworkCore   @* <- Needed for CountAsync *@
@inject UserManager<ApplicationUser> UserManager
@inject HelpDeskContext Db

@{
    int agentCount = 0;
    int unreadNotificationCount = 0;

    if (User.Identity.IsAuthenticated)
    {
        var currentUser = await UserManager.GetUserAsync(User);

        if (currentUser != null)
        {
            // Count agents
            var agents = await UserManager.GetUsersInRoleAsync("Agent");
            agentCount = agents.Count;

            // Count unread notifications for the current user
            unreadNotificationCount = await Db.Notifications
                .Where(n => n.UserId == currentUser.Id && !n.IsRead)
                .CountAsync();
        }
    }
}


