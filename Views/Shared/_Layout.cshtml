    <!-- AdminLTE JS -->
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>


    <script>
        $(function () {
            // ==========================
            // Initialize all DataTables by class
            // ==========================
            $('.custom-datatable').each(function () {
                let tableId = $(this).attr('id');
                let table = $('#' + tableId).DataTable({
                    paging: true,
                    searching: true,
                    ordering: true,
                    info: true,
                    autoWidth: true,
                    lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, "All"]],
                    responsive: true,
                    dom: '<"top d-flex justify-content-between"lf>rt<"bottom"ip><"clear">',
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder:"Type here to search"
                    },
                    columnDefs: [
                        {
                            orderable: false,
                            targets: -1,
                            className: 'text-center'
                        },
                        {
                            targets: "_all",
                            className: 'align-middle'
                        }
                    ],

                    // ==========================
                    // Fix: Make "Show X entries" dropdown Bootstrap styled
                    // ==========================
                    drawCallback: function () {
                        $('#' + tableId + '_length select')
                            .addClass('form-select form-select-sm');
                    }
                });

                // Add search icon inside each DataTable's search input
                $('#' + tableId + '_filter input')
                    .removeClass('form-control-sm')
                    .addClass('form-control ps-5')
                    .wrap('<div class="position-relative d-inline-block"></div>')
                    .before('<i class="fas fa-search position-absolute" style="left:10px; top:50%; transform:translateY(-50%); color:#aaa;"></i>');

            });

            // ==========================
            // Show TempData messages
            // ==========================
            var errorMessage = '@TempData["ErrorMessage"]';
            var successMessage = '@TempData["SuccessMessage"]';

            if (errorMessage) showMessage('error', errorMessage);
            else if (successMessage) showMessage('success', successMessage);

            // ==========================
            // Sidebar toggle (mobile)
            // ==========================
            $('.navbar-toggler').on('click', function () {
                $('#sidebar').toggleClass('active');
                $('#main-content').toggleClass('sidebar-active');
            });
        });

        // ==========================
        // Function to show modal message
        // ==========================
        function showMessage(type, message) {
            $('#modalMessageContent').html(message);
            let bgColor = type === 'error' ? '#dc3545' : '#28a745';
            $('#messageModal .modal-header').css({ backgroundColor: bgColor, color: 'white' });
            new bootstrap.Modal(document.getElementById('messageModal')).show();
        }

        // ==========================
        // Submenu toggle
        // ==========================
        function toggleSubMenu(element, menuId) {
            document.querySelectorAll('.submenu').forEach(submenu => {
                if (submenu.id !== menuId) {
                    submenu.style.display = 'none';
                    let toggleBtn = submenu.closest('.nav-item')?.querySelector('.toggle-menu');
                    if (toggleBtn) toggleBtn.classList.remove('active');
                }
            });

            const subMenu = document.getElementById(menuId);
            if (subMenu.style.display === "none" || subMenu.style.display === "") {
                subMenu.style.display = "block";
                element.classList.add('active');
            } else {
                subMenu.style.display = "none";
                element.classList.remove('active');
            }
        }

        // ==========================
        // Price + VAT calculation
        // ==========================
        function calculateTotal() {
            let price = parseFloat(document.getElementById("Price")?.value) || 0;
            let vat = parseFloat(document.getElementById("Vat")?.value) || 0;
            let total = price + (price * vat / 100);
            if (document.getElementById("GrandTotal")) {
                document.getElementById("GrandTotal").value = total.toFixed(2);
            }
        }

        // ==========================
        // Helper function to show toast notifications
        // ==========================
        function showToast(type, message) {
            const toastContainer = $('#toast-container');
            if (toastContainer.length === 0) {
                $('body').append('<div id="toast-container" style="position: fixed; top: 20px; right: 20px; z-index: 9999;"></div>');
            }

            const toastId = 'toast-' + Date.now();
            const bgColor = type === 'error' ? 'bg-danger' : type === 'warning' ? 'bg-warning' : 'bg-success';
            const icon = type === 'error' ? 'fa-exclamation-circle' : type === 'warning' ? 'fa-exclamation-triangle' : 'fa-check-circle';

            const toastHtml = `
                                    <div id="${toastId}" class="toast ${bgColor} text-white" role="alert" style="min-width: 300px;">
                                        <div class="toast-header ${bgColor} text-white">
                                            <i class="fas ${icon} me-2"></i>
                                            <strong class="me-auto">${type.charAt(0).toUpperCase() + type.slice(1)}</strong>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                                        </div>
                                        <div class="toast-body">
                                            ${message}
                                        </div>
                                    </div>
                                `;

            $('#toast-container').append(toastHtml);
            const toastEl = document.getElementById(toastId);
            const toast = new bootstrap.Toast(toastEl, { delay: 5000 });
            toast.show();

            toastEl.addEventListener('hidden.bs.toast', function () {
                $(this).remove();
            });
        }

        // ==========================
        // Initialize all tooltips
        // ==========================
        $(function () {
            $('[data-bs-toggle="tooltip"]').tooltip();
        });
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>

