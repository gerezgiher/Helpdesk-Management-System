@using HelpdeskSystem.Models
@using HelpdeskSystem.Data
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject HelpDeskContext Db

@{
    var user = await UserManager.GetUserAsync(User);

    var unreadCount = user == null
        ? 0
        : Db.Notifications.Count(n => n.UserId == user.Id && !n.IsRead);

    var recentRequests = new List<Ticket>();

    if (user != null)
    {
        recentRequests = Db.Tickets
            .OrderByDescending(t => t.CreatedAt)
            .Take(5)
            .ToList();
    }
}

@if (User.Identity.IsAuthenticated)
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center position-relative px-3"
           href="#"
           id="notificationsDropdown"
           role="button"
           data-bs-toggle="dropdown"
           aria-expanded="false">

            <span class="position-relative d-inline-flex align-items-center">
                <i class="fas fa-bell fs-5"></i>

                @if (unreadCount > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        @unreadCount
                        <span class="visually-hidden">unread notifications</span>
                    </span>
                }
            </span>

            <span class="ms-2">Requests</span>
        </a>

        <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2"
            aria-labelledby="notificationsDropdown"
            style="min-width: 340px;">

            <li class="px-3 py-2">
                <div class="fw-bold text-primary">Recent Requests</div>
                <small class="text-muted">Latest 5 requests</small>
            </li>

            <li><hr class="dropdown-divider" /></li>

            @if (recentRequests.Any())
            {
                @foreach (var request in recentRequests)
                {
                    <li>
                        <a class="dropdown-item py-2"
                           asp-controller="Tickets"
                           asp-action="Details"
                           asp-route-id="@request.Id">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="me-2">
                                    <div class="fw-medium text-truncate">@request.Title</div>
                                    <small class="text-muted text-truncate d-block">
                                        @request.Description
                                    </small>
                                </div>
                                <small class="text-muted text-nowrap">
                                    @request.CreatedAt.ToString("dd MMM")
                                </small>
                            </div>
                        </a>
                    </li>
                }
            }
            else
            {
                <li>
                    <span class="dropdown-item-text text-muted">
                        No recent requests found.
                    </span>
                </li>
            }

            <li><hr class="dropdown-divider" /></li>

            <li>
                <a class="dropdown-item text-center fw-semibold text-primary"
                   asp-controller="Tickets"
                   asp-action="Index">
                    View All Requests
                </a>
            </li>
        </ul>
    </li>
}