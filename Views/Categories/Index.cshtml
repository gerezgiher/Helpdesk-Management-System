@model IEnumerable<HelpdeskSystem.Models.Category>

<h2 class="text-center mb-4 text-primary">Categories List</h2>

<div class="mb-3 text-end">
    <a asp-action="Create" class="btn btn-success">+ New Category</a>
</div>

<table id="categoriesTable" class="table table-striped table-bordered custom-datatable">
    <thead>
        <tr>
            <th>Category Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Details" asp-route-id="@category.Id" class="btn btn-sm btn-outline-info"> Details </a>
                    <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Are you sure you want to delete this category?');">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>


