@model HelpdeskSystem.Models.RegisterViewModel

@* @{
    ViewData["Title"] = "Register";
} *@

<hr />

<div class="row justify-content-center">
    <div class="col-md-6">
        <form asp-action="Register" method="post">
           @*  <div asp-validation-summary="All" class="text-danger mb-3"></div> *@

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            <!-- Registration Panel -->
            <div class="panel panel-default mb-4 border rounded shadow-sm">
                <div class="panel-heading bg-light p-3 border-bottom rounded-top text-center">
                    <h4 class="panel-title fw-bold text-darkcyan">User Registeration</h4>
                </div>

                <div class="panel-body p-4">
                    <div class="mb-3 w-100" style="max-width:450px; margin:auto;">
                        <div class="d-flex align-items-center">
                            <label asp-for="FullName" class="control-label fw-bold mb-0 me-3" style="min-width:120px;">Full Name</label>
                            <input asp-for="FullName" class="form-control" />
                        </div>
                        <div style="margin-left:120px;">
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 w-100" style="max-width:450px; margin:auto;">
                        <div class="d-flex align-items-center">
                            <label asp-for="Email" class="control-label fw-bold mb-0 me-3" style="min-width:120px;">Email</label>
                            <input asp-for="Email" class="form-control" />
                        </div>
                        <div style="margin-left:120px;">
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 w-100" style="max-width:450px; margin:auto;">
                        <div class="d-flex align-items-center">
                            <label asp-for="Password" class="control-label fw-bold mb-0 me-3" style="min-width:120px;">Password</label>
                            <input asp-for="Password" type="password" class="form-control" />
                        </div>
                        <div style="margin-left:120px;">
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 w-100" style="max-width:450px; margin:auto;">
                        <div class="d-flex align-items-center">
                            <label asp-for="ConfirmPassword" class="control-label fw-bold mb-0 me-3" style="min-width:120px;">Confirm Password</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" />
                        </div>
                        <div style="margin-left:120px;">
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Buttons -->
            <div class="text-center mt-4 pt-3 border-top">
                <a asp-action="Login" class="btn btn-outline-secondary btn-sm px-4 py-2">
                    <i class="fas fa-arrow-left me-2"></i>Back to List
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <style>
        .form-control {
            width: 100% !important;
        }

        .field-validation-error {
            display: block;
            margin-top: 5px;
        }

        .text-darkcyan {
            color: darkcyan;
        }
    </style>
}
