@model HelpdeskSystem.Models.ChangePasswordViewModel

@* @{
    ViewData["Title"] = "Change Password";
} *@

<hr />

<div class="row justify-content-center">
    <div class="col-md-6">
        <form method="post">
            @Html.AntiForgeryToken()

            <!-- Change Password Panel -->
            <div class="panel panel-default mb-4 border rounded shadow-sm">
                <div class="panel-heading bg-light p-3 border-bottom rounded-top text-center">
                    <h4 class="panel-title fw-bold text-darkcyan">Change Password</h4>
                </div>

                <div class="panel-body p-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Old Password -->
                    <div class="mb-3 w-100" style="max-width: 450px; margin: auto;">
                        <div class="d-flex align-items-center">
                            <label asp-for="OldPassword" class="control-label fw-bold mb-0 me-3"
                                   style="min-width: 150px;">Old Password</label>
                            <input asp-for="OldPassword" type="password" class="form-control" />
                        </div>
                        <div style="margin-left: 150px;">
                            <span asp-validation-for="OldPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- New Password -->
                    <div class="mb-3 w-100" style="max-width: 450px; margin: auto;">
                        <div class="d-flex align-items-center">
                            <label asp-for="NewPassword" class="control-label fw-bold mb-0 me-3"
                                   style="min-width: 150px;">New Password</label>
                            <input asp-for="NewPassword" type="password" class="form-control" />
                        </div>
                        <div style="margin-left: 150px;">
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Confirm Password -->
                    <div class="mb-3 w-100" style="max-width: 450px; margin: auto;">
                        <div class="d-flex align-items-center">
                            <label asp-for="ConfirmPassword" class="control-label fw-bold mb-0 me-3"
                                   style="min-width: 150px;">Confirm Password</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" />
                        </div>
                        <div style="margin-left: 150px;">
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-primary px-4 me-2">Change Password</button>
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary px-4">
                            Cancel
                        </a>
 @*                        <a asp-action="Profile" class="btn btn-outline-secondary px-4">Cancel</a> *@
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <style>
        .form-control {
            width: 100% !important;
        }

        .field-validation-error {
            display: block;
            margin-top: 5px;
        }

        select.form-control {
            height: 38px;
        }

        .text-darkcyan {
            color: darkcyan;
        }
    </style>
}
