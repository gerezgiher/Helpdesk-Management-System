@model HelpdeskSystem.Models.HomeDashboardViewModel

<div class="container-fluid dashboard-container">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-dark">
                Welcome back, @User.Identity.Name 👋
            </h2>
            <p class="text-muted mb-0">
                Helpdesk Management Dashboard
            </p>
        </div>

        <div>
            <span class="badge bg-primary px-3 py-2">
                @Model.Role
            </span>
        </div>

    </div>



    <!-- ================= ADMIN DASHBOARD ================= -->
    @if (Model.Role == "Admin")
    {

        <div class="row g-4">


            <div class="col-xl-3 col-md-6">
                <div class="dashboard-card bg-gradient-primary">

                    <div>
                        <p>Total Employees</p>
                        <h2>@Model.TotalEmployees</h2>
                    </div>

                    <i class="fas fa-users"></i>

                </div>
            </div>



            <div class="col-xl-3 col-md-6">

                <div class="dashboard-card bg-gradient-success">

                    <div>
                        <p>Total Departments</p>
                        <h2>@Model.TotalDepartments</h2>
                    </div>

                    <i class="fas fa-building"></i>

                </div>

            </div>



            <div class="col-xl-3 col-md-6">

                <div class="dashboard-card bg-gradient-info">

                    <div>
                        <p>Total Blocks</p>
                        <h2>@Model.TotalBlocks</h2>
                    </div>

                    <i class="fas fa-layer-group"></i>

                </div>

            </div>



            <div class="col-xl-3 col-md-6">

                <div class="dashboard-card bg-gradient-warning">

                    <div>
                        <p>Active Technicians</p>
                        <h2>@Model.Agents.Count()</h2>
                    </div>

                    <i class="fas fa-user-cog"></i>

                </div>

            </div>


        </div>

    }



    <!-- ================= DEPARTMENT HEAD ================= -->
    @if (Model.Role == "DepartmentHead")
    {
        <div class="row g-4">

            <div class="col-xl-3 col-md-6">
                <div class="dashboard-card bg-gradient-primary">
                    <p>Total Requests</p>
                    <h2>@Model.TotalRequests</h2>
                    <i class="fas fa-ticket-alt"></i>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="dashboard-card bg-gradient-warning">
                    <p>Pending</p>
                    <h2>@Model.PendingRequests</h2>
                    <i class="fas fa-clock"></i>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="dashboard-card bg-gradient-success">
                    <p>Approved</p>
                    <h2>@Model.ApprovedRequests</h2>
                    <i class="fas fa-check"></i>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="dashboard-card bg-gradient-danger">
                    <p>Rejected</p>
                    <h2>@Model.RejectedRequests</h2>
                    <i class="fas fa-ban"></i>
                </div>
            </div>

        </div>

        <br />

        <div class="card shadow-lg border-0 rounded-4">

            <div class="card-header bg-white">
                <h5 class="fw-bold">
                    <i class="fas fa-list"></i>
                    Department Requests
                </h5>
            </div>

            <div class="table-responsive">

                <table id="dhTicketsTable"
                       class="table table-striped table-bordered custom-datatable">

                    <thead class="table-light">
                        <tr>
                            <th>Category</th>
                            <th>Title</th>
                            <th>Requester</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Reason</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var ticket in Model.Tickets ?? new List<HelpdeskSystem.Models.Ticket>())
                        {
                            <tr>

                                <td>@ticket.Category?.Name</td>

                                <td>@ticket.Title</td>

                                <td>@ticket.CreatedByEmployee?.FullName</td>

                                <td>
                                    @if (ticket.Approval == null)
                                    {
                                        <span class="badge bg-warning">Pending</span>
                                    }
                                    else if (ticket.Approval.Status == HelpdeskSystem.Models.ApprovalStatus.Pending)
                                    {
                                        <span class="badge bg-warning">Pending</span>
                                    }
                                    else if (ticket.Approval.Status == HelpdeskSystem.Models.ApprovalStatus.Approved)
                                    {
                                        <span class="badge bg-success">Approved</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                    }
                                </td>

                                <td>
                                    @ticket.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @(ticket.Approval?.RejectionReason ?? "-")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

    <!-- ================= EMPLOYEE / AGENT ================= -->
    @if (Model.Role == "Agent" || Model.Role == "Employee")
    {


        <div class="row g-4">


            <div class="col-xl-3 col-md-6">

                <div class="dashboard-card bg-gradient-primary">

                    <p>Total Requests</p>

                    <h2>@Model.TotalRequests</h2>

                    <i class="fas fa-ticket-alt"></i>

                </div>

            </div>



            <div class="col-xl-3 col-md-6">

                <div class="dashboard-card bg-gradient-warning">

                    <p>Pending</p>

                    <h2>@Model.PendingRequests</h2>

                    <i class="fas fa-hourglass-half"></i>

                </div>

            </div>



            <div class="col-xl-3 col-md-6">

                <div class="dashboard-card bg-gradient-success">

                    <p>Resolved</p>

                    <h2>@Model.ResolvedRequests</h2>

                    <i class="fas fa-check-circle"></i>

                </div>

            </div>



            <div class="col-xl-3 col-md-6">

                <div class="dashboard-card bg-gradient-danger">

                    <p>Rejected</p>

                    <h2>@Model.RejectedRequests</h2>

                    <i class="fas fa-ban"></i>

                </div>

            </div>


        </div>


    }


</div>





<style>


    .dashboard-container {
        padding: 25px;
    }



    .dashboard-card {
        height: 150px;
        border-radius: 20px;
        padding: 25px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 10px 25px rgba(0,0,0,.15);
        transition: .3s;
    }



        .dashboard-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 35px rgba(0,0,0,.25);
        }



        .dashboard-card p {
            font-size: 14px;
            text-transform: uppercase;
            opacity: .9;
            margin: 0;
        }



        .dashboard-card h2 {
            font-size: 38px;
            font-weight: 700;
            margin-top: 10px;
        }



        .dashboard-card i {
            font-size: 55px;
            opacity: .35;
        }





    .bg-gradient-primary {
        background: linear-gradient(135deg,#667eea,#764ba2);
    }



    .bg-gradient-success {
        background: linear-gradient(135deg,#11998e,#38ef7d);
    }



    .bg-gradient-info {
        background: linear-gradient(135deg,#2193b0,#6dd5ed);
    }



    .bg-gradient-warning {
        background: linear-gradient(135deg,#f7971e,#ffd200);
    }



    .bg-gradient-danger {
        background: linear-gradient(135deg,#ff416c,#ff4b2b);
    }



    .card {
        border: none;
    }



    .table thead th {
        font-size: 13px;
        text-transform: uppercase;
    }



    .badge {
        padding: 8px 12px;
        border-radius: 20px;
    }

</style>