@model HelpdeskSystem.Models.AssignAgentViewModel
<h2 class="text-center mb-4">Assign Agent</h2>


<table id="assignAgentTable" class="table table-bordered table-striped custom-datatable">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>
                    @if (!Model.Agents.Contains(user))
                    {
                        <form asp-action="AssignAgent" method="post">
                            <input type="hidden" name="userId" value="@user.Id" />
                            <button type="submit" class="btn btn-primary btn-sm">Assign as Agent</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-success">Already Agent</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

