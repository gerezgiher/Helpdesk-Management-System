@model HelpdeskSystem.Models.ApplicationUser

<hr />

<div class="row">
    <div class="col-md-12">
        <form asp-action="CreateUser" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- User Information Panel -->
            <div class="panel panel-default mb-4 border rounded shadow-sm">
                <div class="panel-heading bg-light p-3 border-bottom rounded-top">
                    <h4 class="panel-title fw-bold text-center" style="color:darkcyan">
                       Create User
                    </h4>
                </div>

                <div class="panel-body p-4">
                    <div class="row">

                        <!-- LEFT COLUMN -->
                        <div class="col-md-6">

                            <!-- First Name -->
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label asp-for="FirstName" class="fw-bold mb-0 me-3" style="min-width:120px;"></label>
                                    <input asp-for="FirstName" class="form-control name-field" />
                                </div>
                                <div style="margin-left:120px;">
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Middle Name -->
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label asp-for="MiddleName" class="fw-bold mb-0 me-3" style="min-width:120px;"></label>
                                    <input asp-for="MiddleName" class="form-control name-field" />
                                </div>
                            </div>

                            <!-- Last Name -->
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label asp-for="LastName" class="fw-bold mb-0 me-3" style="min-width:120px;"></label>
                                    <input asp-for="LastName" class="form-control name-field" />
                                </div>
                                <div style="margin-left:120px;">
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                            </div>

                        </div>

                        <!-- RIGHT COLUMN -->
                        <div class="col-md-6">

                            <!-- Email -->
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label asp-for="Email" class="fw-bold mb-0 me-3" style="min-width:120px;"></label>
                                    <input asp-for="Email" class="form-control" />
                                </div>
                                <div style="margin-left:120px;">
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Phone -->
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label asp-for="PhoneNumber" class="fw-bold mb-0 me-3" style="min-width:120px;"></label>
                                    <input asp-for="PhoneNumber" class="form-control name-field" />
                                </div>
                                <div style="margin-left:120px;">
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Password -->
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label class="fw-bold mb-0 me-3" style="min-width:120px;">
                                        New Password
                                    </label>
                                    <input type="password" name="password" class="form-control" />
                                </div>
                                <div style="margin-left:120px;">
                                    <small class="text-muted">Leave empty to keep current password</small>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            </div>

            <!-- Buttons -->
            <div class="form-group">
                <button type="submit" class="btn btn-primary px-4 me-2">Create User</button>
                <a asp-action="Users" class="btn btn-outline-secondary px-4">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function updateFullName() {
            const f = document.querySelector('[name="FirstName"]').value || '';
            const m = document.querySelector('[name="MiddleName"]').value || '';
            const l = document.querySelector('[name="LastName"]').value || '';
            document.querySelector('[name="FullName"]').value =
                `${f} ${m} ${l}`.replace(/\s+/g, ' ').trim();
        }

        document.querySelectorAll('.name-field')
            .forEach(x => x.addEventListener('input', updateFullName));
    </script>
}
