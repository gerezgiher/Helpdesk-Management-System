@model Microsoft.AspNetCore.Identity.IdentityRole

@{
    // ViewData["Title"] = "Edit Role";
}


<div class="container-fluid">

    <form asp-action="EditRole" method="post">

        <input type="hidden" asp-for="Id" />


        <!-- Role Information Panel -->
        <div class="panel panel-default mb-4 border rounded shadow-sm">


            <div class="panel-heading bg-light p-3 border-bottom rounded-top">

                <h4 class="panel-title fw-bold text-center"
                    style="color:darkcyan">

                    Edit Role

                </h4>

            </div>



            <div class="panel-body p-4">


                <div class="row">


                    <!-- Left Column -->
                    <div class="col-md-6">


                        <!-- Role Name -->
                        <div class="mb-3 w-100" style="max-width:450px;">

                            <div class="d-flex align-items-center">

                                <label asp-for="Name"
                                       class="control-label fw-bold mb-0 me-3"
                                       style="min-width:120px;">

                                    Role Name

                                </label>


                                <input asp-for="Name"
                                       class="form-control"
                                       placeholder="Enter role name" />

                            </div>


                            <div style="margin-left:120px;">

                                <span asp-validation-for="Name"
                                      class="text-danger">
                                </span>

                            </div>


                        </div>



                    </div>



                    <!-- Right Column -->
                    <div class="col-md-6">


                        <!-- Normalized Name -->
                        <div class="mb-3 w-100" style="max-width:450px;">

                            <div class="d-flex align-items-center">


                                <label asp-for="NormalizedName"
                                       class="control-label fw-bold mb-0 me-3"
                                       style="min-width:120px;">

                                    Normalized

                                </label>


                                <input asp-for="NormalizedName"
                                       class="form-control"
                                       readonly />

                            </div>


                            <div style="margin-left:120px;">

                                <span asp-validation-for="NormalizedName"
                                      class="text-danger">
                                </span>

                            </div>


                        </div>


                    </div>



                </div>


            </div>


        </div>



        <!-- Buttons -->
        <div class="form-group text-center mt-4">

            <!-- Primary Action -->
            <button type="submit"
                    class="btn btn-primary px-4 me-2">

                <i class="fas fa-save me-2"></i>
                Update

            </button>


            <!-- Secondary Action -->
            <a asp-action="Roles"
               class="btn btn-outline-secondary px-4">

                <i class="fas fa-arrow-left me-2"></i>
                Back to Roles

            </a>

        </div>


    </form>


</div>



@section Scripts {


    <partial name="_ValidationScriptsPartial" />


    <style>


        /* Uniform input field widths */

        .form-control {
            width: 100% !important;
        }


        .field-validation-error {
            display: block;
            margin-top: 5px;
        }


        select.form-control {
            height: 38px;
        }


        .form-check-input {
            margin-left: 0;
        }

    </style>


}