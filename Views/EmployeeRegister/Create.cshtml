@model HelpdeskSystem.Models.EmployeeRegisterViewModel

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-4">

        <!-- Header -->
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="mb-0 fw-semibold text-primary">Register Employee</h5>
        </div>

        <!-- Body -->
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label">First Name</label>
                        <input asp-for="FirstName" class="form-control form-control-lg" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Middle Name</label>
                        <input asp-for="MiddleName" class="form-control form-control-lg" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Last Name</label>
                        <input asp-for="LastName" class="form-control form-control-lg" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Email</label>
                        <input asp-for="Email" class="form-control form-control-lg" autocomplete="off" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Phone</label>
                        <input asp-for="PhoneNumber" class="form-control form-control-lg" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Gender</label>
                        <select asp-for="Gender"
                                asp-items="Html.GetEnumSelectList<Gender>()"
                                class="form-select form-select-lg">
                            <option value="">-- Select Gender --</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Department</label>
                        <select asp-for="DepartmentId"
                                class="form-select form-select-lg"
                                asp-items="@(new SelectList(Model.Departments, "Id", "DepartmentName"))">
                            <option value="">-- Select Department --</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Block</label>
                        <select asp-for="BlockId"
                                class="form-select form-select-lg"
                                asp-items="@(new SelectList(Model.Blocks, "Id", "BlockName"))">
                            <option value="">-- Select Block --</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-control form-control-lg" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                  @*   <div class="col-md-6">
                        <label class="form-label">Confirm Password</label>
                        <input asp-for="ConfirmPassword" class="form-control form-control-lg" />
                    </div> *@

                    <div class="col-md-4">
                        <label class="form-label">Status</label>
                        <select asp-for="AvailabilityStatus"
                                asp-items="Html.GetEnumSelectList<AvailabilityStatus>()"
                                class="form-select form-select-lg">
                        </select>
                    </div>

                </div>

                <!-- Footer -->
                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light btn-lg px-4">Back</a>
                    <button type="submit" class="btn btn-success btn-lg px-4">
                        Register
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
