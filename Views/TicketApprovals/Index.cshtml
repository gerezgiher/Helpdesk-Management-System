@model IEnumerable<HelpdeskSystem.Models.TicketApproval>
@using HelpdeskSystem.Models

<h2 class="text-center mb-4 text-primary">Ticket Approvals</h2>

<div class="mb-3 text-end">
    @* Optional: Add a "Create Approval" button if needed *@
    <a asp-action="Create" class="btn btn-success">+ Add Approval</a>
</div>

<table id="approvalsTable" class="table table-striped table-bordered custom-datatable">
    <thead class="table-dark">
        <tr>
            <th>Ticket Title</th>
            <th>Requester</th>
            <th>DH Approval</th>
            <th>Status</th>
            <th>Decision Date</th>
            <th>Approved By</th>
            <th>Rejection Reason</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(item.Ticket?.Title ?? "N/A")</td>
                <td>@(item.Ticket?.CreatedByEmployee?.FullName)</td>
                <td>
                    <span class="badge @(item.Status switch
                    {
                        ApprovalStatus.Approved => "bg-success",
                        ApprovalStatus.Rejected => "bg-danger",
                        _ => "bg-warning text-dark"
                    })">
                        @item.Status
                    </span>
                </td>
                <td>@(item.Ticket?.Status?.Name ?? "N/A")</td>
                <td>@item.DecisionDate?.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@item.ApprovedBy?.FullName</td>
                <td>@item.RejectionReason</td>
                <td>
                    
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"> Details </a>
                    @if (item.Status == ApprovalStatus.Pending)
                    {
                        <a asp-action="ApproveStatus" asp-route-id="@item.TicketId" class="btn btn-sm btn-success mb-1">
                            <i class="fas fa-check-circle"></i> Approve
                        </a>
                    }
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger mb-1">
                        <i class="fas fa-trash-alt"></i> Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.5/css/jquery.dataTables.min.css" />
    <script src="https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#agentsTable').DataTable();
            $('#dhTicketsTable').DataTable();
        });
    </script>
}