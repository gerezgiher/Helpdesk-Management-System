@model HelpdeskSystem.Models.Ticket
@using HelpdeskSystem.Models

@{
    var agents = ViewBag.Agents as List<ApplicationUser> ?? new();
    var statuses = ViewBag.Statuses as List<Status> ?? new();
    var currentUserId = ViewBag.CurrentUserId as string;

    var approval = Model.Approval;
    bool isApproved = approval?.Status == ApprovalStatus.Approved;
    bool isRejected = approval?.Status == ApprovalStatus.Rejected;

    bool isUserOwner = Model.CreatedById == currentUserId;
    bool isAssignedAgent = Model.AssignedToId == currentUserId;
}

<hr />

<div class="row">
    <div class="col-md-10 offset-md-1">

        <!-- Ticket Details Panel -->
        <div class="panel panel-default mb-4 border rounded shadow-sm">
            <div class="panel-heading bg-light p-3 border-bottom rounded-top">
                <h4 class="panel-title fw-bold text-center" style="color:darkcyan">
                    Request Details
                </h4>
            </div>

            <div class="panel-body p-4">

                <!-- Ticket Information Section -->
                <div class="mb-4">


                    <!-- Row 1: Created By & Created At -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px;">Full Name</label>
                                    <input class="form-control" value="@Model.CreatedByEmployee?.FullName" readonly />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px;">Created At</label>
                                    <input class="form-control" value="@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: Category & Priority -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px;">Category</label>
                                    <input class="form-control" value="@Model.Category?.Name" readonly />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px;">Priority</label>
                                    <input class="form-control" value="@Model.Priority?.Name" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 3: Status & DH Approval -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px;">Status</label>
                                    <input class="form-control" value="@GetDisplayStatus(Model.Status?.Name)" readonly />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px;">DH Approval</label>
                                    <input class="form-control" value="@(approval?.Status.ToString() ?? "Pending")" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 4: Assignment Type & Assigned To -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px;">Assignment Type</label>
                                    <input class="form-control" value="@Model.AssignmentType" readonly />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px;">Assigned To</label>
                                    <input class="form-control" value="@(Model.AssignedTo?.FullName ?? "Not assigned")" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3 w-100">
                        <div class="d-flex align-items-start">
                            <label class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px;">Description</label>
                            <textarea class="form-control" rows="4" readonly>@Model.Description</textarea>
                        </div>
                    </div>

                    @if (isRejected && !string.IsNullOrEmpty(approval?.RejectionReason))
                    {
                        <div class="mb-3 w-100">
                            <div class="d-flex align-items-start">
                                <label class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px; color:#dc3545;">Rejection Reason</label>
                                <textarea class="form-control" rows="2" readonly>@approval?.RejectionReason</textarea>
                            </div>
                        </div>
                    }

                    @if (Model.Attachments?.Any() == true)
                    {
                        <div class="mb-3 w-100">
                            <div class="d-flex align-items-start">
                                <label class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px;">Attachments</label>
                                <div class="flex-grow-1">
                                    <ul class="list-group list-group-flush">
                                        @foreach (var a in Model.Attachments)
                                        {
                                            <li class="list-group-item py-1 px-0 border-0">
                                                <a href="@a.FilePath" target="_blank" class="text-decoration-none text-primary">
                                                    <i class="fas fa-paperclip me-2"></i>@a.FileName
                                                </a>
                                                <span class="text-muted small ms-2">(@(a.Size / 1024) KB)</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <hr />

                <!-- Comments Section -->
                <div class="mb-4">
                    <h5 class="fw-bold mb-3 text-center" style="color:darkcyan">
                        Comments (@(Model.Comments?.Count() ?? 0))
                    </h5>

                    @if (Model.Comments?.Any() == true)
                    {
                        <div class="comments-container mb-3" style="max-height: 300px; overflow-y: auto;">
                            @foreach (var c in Model.Comments.OrderByDescending(x => x.CreatedAt))
                            {
                                <partial name="_CommentItem" model="c" />
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-3 bg-light rounded mb-3">
                            <i class="fas fa-comment-slash text-muted fa-lg mb-2"></i>
                            <p class="text-muted small mb-0">No comments yet</p>
                        </div>
                    }

                    <!-- Comment Form - Only shown if DH approved and user is Admin/Assigned Agent -->
                    @if ((User.IsInRole("Admin") || (User.IsInRole("Agent") && isAssignedAgent)) && isApproved)
                    {
                        <form asp-action="AddComment" method="post">
                            <input type="hidden" name="ticketId" value="@Model.Id" />

                            <div class="mb-3 w-100">
                                <div class="d-flex align-items-center">
                                    <label class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px;">Add Comment</label>
                                    <textarea name="message" class="form-control"
                                              rows="3" placeholder="Write your comment here..." required></textarea>
                                </div>
                            </div>

                            <div class="text-end">
                                <button class="btn btn-primary btn-sm px-4 py-2">
                                    <i class="fas fa-paper-plane me-2"></i>Post Comment
                                </button>
                            </div>
                        </form>
                    }
                </div>

                <hr />

                <!-- Actions Section -->
                <div class="mb-4">
                    <h5 class="fw-bold mb-3 text-center" style="color:darkcyan">Actions</h5>

                    <!-- Department Head Approval -->
                    @if (User.IsInRole("DepartmentHead") && (approval == null || approval.Status == ApprovalStatus.Pending))
                    {
                        <div class="mb-4">
                            <form asp-controller="TicketApprovals" asp-action="Create" method="post">
                                <input type="hidden" name="TicketId" value="@Model.Id" />

                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="mb-3 w-100" style="max-width:450px;">
                                            <div class="d-flex align-items-center">
                                                <label class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px;">Decision</label>
                                                <select id="approvalStatus" name="Status" class="form-control">
                                                    <option disabled selected>Select decision</option>
                                                    <option value="Approved">Approve</option>
                                                    <option value="Rejected">Reject</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3 w-100" style="max-width:450px;">
                                            <button class="btn btn-success btn-sm w-100 py-2">
                                                <i class="fas fa-check me-2"></i>Submit Decision
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div id="rejectionReason" style="display:none;">
                                    <div class="mb-3 w-100">
                                        <div class="d-flex align-items-center">
                                            <label class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px;">Rejection Reason</label>
                                            <textarea name="RejectionReason"
                                                      class="form-control"
                                                      rows="2"
                                                      placeholder="Please provide a reason for rejection..."></textarea>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    }

                    <!-- Assign / Reassign Ticket - Only if approved -->
                    @if ((User.IsInRole("Admin") || User.IsInRole("DepartmentHead")) && isApproved)
                    {
                        <div class="mb-4">
                            <form asp-action="Assign" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ticketId" value="@Model.Id" />

                                <div class="row align-items-center mb-3">
                                    <!-- Assignment Type Dropdown -->
                                    <div class="col-md-4">
                                        <div class="mb-0 w-100">
                                            <div class="d-flex align-items-center">
                                                <label class="control-label font-weight-bold mb-0 me-2" style="min-width:100px;">Assignment Type</label>
                                                <select id="assignmentType" name="assignmentType" class="form-control form-control-sm">
                                                    <option value="Manual" selected="@(Model.AssignmentType == AssignmentType.Manual)">Manual</option>
                                                    <option value="Automatic" selected="@(Model.AssignmentType == AssignmentType.Automatic)">Automatic</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Agent Selection (Manual) -->
                                    <div class="col-md-4" id="manualAssign">
                                        <div class="mb-0 w-100">
                                            <div class="d-flex align-items-center">
                                                <label class="control-label font-weight-bold mb-0 me-2" style="min-width:100px;">Select Agent</label>
                                                <select name="agentId" class="form-control form-control-sm">
                                                    <option value="">-- Unassigned --</option>
                                                    @foreach (var ag in agents)
                                                    {
                                                        <option value="@ag.Id" selected="@(ag.Id == Model.AssignedToId)">
                                                            @ag.FullName
                                                        </option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Button -->
                                    <div class="col-md-2">
                                        <div class="mb-0 w-100">
                                            <button class="btn btn-outline-primary btn-sm w-100 py-1 px-2">
                                                <i class="fas fa-user-plus me-1"></i>
                                                @(Model.AssignedToId == null ? "Assign" : "Reassign")
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    }

                    <!-- Change Status - Admin or Assigned Agent (doesn't require approval) -->
                    @if ((User.IsInRole("Admin") || (User.IsInRole("Agent") && isAssignedAgent)))
                    {
                        <div class="mb-4">
                            <form asp-action="ChangeStatus" method="post">
                                <input type="hidden" name="ticketId" value="@Model.Id" />

                                <div class="row align-items-center">
                                    <!-- Status Dropdown -->
                                    <div class="col-md-4">
                                        <div class="mb-0 w-100">
                                            <div class="d-flex align-items-center">
                                                <label class="control-label font-weight-bold mb-0 me-2" style="min-width:100px;">New Status</label>
                                                <select name="statusId" class="form-control form-control-sm">
                                                    @foreach (var s in statuses)
                                                    {
                                                        <option value="@s.Id" selected="@(s.Id == Model.StatusId)">
                                                            @GetDisplayStatus(s.Name)
                                                        </option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Button -->
                                    <div class="col-md-2">
                                        <div class="mb-0 w-100">
                                            <button class="btn btn-outline-secondary btn-sm w-100 py-1 px-2">
                                                <i class="fas fa-save me-1"></i>Update
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    }
                </div>

                <!-- Additional Information at the Bottom -->
                <div class="row mt-4 pt-3 border-top">
                    <!-- Assignment Type -->
                    <div class="col-md-3 d-flex align-items-center">
                        <label class="fw-bold small mb-0 me-2">Assignment Type:</label>
                        <span class="text-muted small">@Model.AssignmentType.ToString()</span>
                    </div>

                    <!-- Assigned To -->
                    <div class="col-md-3 d-flex align-items-center">
                        <label class="fw-bold small mb-0 me-2">Assigned To:</label>
                        <span class="text-muted small">@(Model.AssignedTo?.FullName ?? "Unassigned")</span>
                    </div>

                    <!-- Last Updated -->
                    <div class="col-md-3 d-flex align-items-center">
                        <label class="fw-bold small mb-0 me-2">Last Updated:</label>
                        <span class="text-muted small">@(Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? Model.CreatedAt.ToString("yyyy-MM-dd HH:mm"))</span>
                    </div>

                    <!-- Ticket ID -->
                    <div class="col-md-3 d-flex align-items-center">
                        <label class="fw-bold small mb-0 me-2">Request ID:</label>
                        <span class="text-muted small">@Model.Id</span>
                    </div>
                </div>

                <!-- Back Button -->
                <div class="text-center mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-4 py-2">
                        <i class="fas fa-arrow-left me-2"></i>Back to List
                    </a>
                </div>

            </div>
        </div>
    </div>

</div>

@section Scripts {
    <style>
        .panel {
            background-color: #fff;
        }

        .panel-body h5 {
            color: #2c3e50;
        }

        .panel-body p {
            font-size: 0.95rem;
        }

        .control-label {
            color: #495057;
            font-weight: 600;
        }

        .comments-container {
            padding-right: 10px;
        }

        .form-control {
            width: 100% !important;
        }

        select.form-control {
            height: 38px;
        }

        textarea.form-control[readonly],
        input.form-control[readonly] {
            background-color: #f8f9fa;
            resize: none;
            border: 1px solid #ced4da;
            color: #495057;
        }

        .list-group-item {
            padding-left: 0;
            padding-right: 0;
        }

        hr {
            margin: 1.5rem 0;
        }

        .btn-sm {
            font-size: 0.875rem;
            line-height: 1.5;
        }
    </style>

    <script>
        // Toggle Manual Assign dropdown
        const typeSelect = document.getElementById("assignmentType");
        const manualDiv = document.getElementById("manualAssign");
        if (typeSelect) {
            const toggle = () => {
                manualDiv.style.display = typeSelect.value === "Manual" ? "block" : "none";
                if (typeSelect.value === "Manual") {
                    manualDiv.querySelector('select').required = true;
                } else {
                    manualDiv.querySelector('select').required = false;
                }
            };
            toggle();
            typeSelect.addEventListener("change", toggle);
        }

        // Show/hide rejection reason
        const approvalSelect = document.getElementById("approvalStatus");
        const rejectionBox = document.getElementById("rejectionReason");
        if (approvalSelect) {
            approvalSelect.addEventListener("change", () => {
                rejectionBox.style.display = approvalSelect.value === "Rejected" ? "block" : "none";
                if (approvalSelect.value === "Rejected") {
                    rejectionBox.querySelector('textarea').required = true;
                } else {
                    rejectionBox.querySelector('textarea').required = false;
                }
            });
        }

        // Form validation
        document.addEventListener('DOMContentLoaded', function () {
            const forms = document.querySelectorAll('form');
            forms.forEach(form => {
                form.addEventListener('submit', function (e) {
                    const requiredFields = this.querySelectorAll('[required]');
                    let isValid = true;

                    requiredFields.forEach(field => {
                        if (!field.value.trim()) {
                            isValid = false;
                            field.classList.add('is-invalid');
                        } else {
                            field.classList.remove('is-invalid');
                        }
                    });

                    if (!isValid) {
                        e.preventDefault();
                        const firstInvalid = this.querySelector('.is-invalid');
                        if (firstInvalid) {
                            firstInvalid.focus();
                        }
                    }
                });
            });
        });
    </script>
}

@functions {
    string GetDisplayStatus(string? n) => n switch
    {
        "Open" => "Pending",
        "Assigned" => "Assigned",
        _ => n ?? "Pending"
    };
}