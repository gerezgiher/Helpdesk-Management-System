@model TicketCreateViewModel

@* @{
    ViewData["Title"] = "Create Ticket";
}
 *@

<hr />
<!-- ========================= -->
<!-- REQUESTER INFORMATION PANEL -->
<!-- ========================= -->
<div class="panel panel-default mb-4 border rounded shadow-sm">
    <div class="panel-heading bg-light p-3 border-bottom rounded-top">
        <h4 class="panel-title fw-bold text-center" style="color:darkcyan">
            Requester Information
        </h4>
    </div>

    <div class="panel-body p-4 d-flex flex-wrap gap-3">

        <!-- Full Name -->
        <div class="mb-3 w-100" style="max-width:450px;">
            <div class="d-flex align-items-center">
                <label class="control-label font-weight-bold mb-0 mr-3"
                       style="min-width:120px;">Requester's Name</label>
                <input class="form-control" value="@Model.RequesterName" readonly />
            </div>
        </div>

        <!-- Email -->
        <div class="mb-3 w-100" style="max-width:450px;">
            <div class="d-flex align-items-center">
                <label class="control-label font-weight-bold mb-0 mr-3"
                       style="min-width:120px;">Requester's Email</label>
                <input class="form-control" value="@Model.RequesterEmail" readonly />
            </div>
        </div>

        <!-- Phone -->
        <div class="mb-3 w-100" style="max-width:450px;">
            <div class="d-flex align-items-center">
                <label class="control-label font-weight-bold mb-0 mr-3"
                       style="min-width:120px;">Requester's Phone</label>
                <input class="form-control" value="@Model.PhoneNumber" readonly />
            </div>
        </div>

        <!-- Department -->
        <div class="mb-3 w-100" style="max-width:450px;">
            <div class="d-flex align-items-center">
                <label class="control-label font-weight-bold mb-0 mr-3"
                       style="min-width:120px;">Requester's Department</label>
                <input class="form-control" value="@Model.DepartmentName" readonly />
            </div>
        </div>

        <!-- Block -->
        <div class="mb-3 w-100" style="max-width:450px;">
            <div class="d-flex align-items-center">
                <label class="control-label font-weight-bold mb-0 mr-3"
                       style="min-width:120px;">Requester's Block</label>
                <input class="form-control" value="@Model.RequesterBlock" readonly />
            </div>
        </div>

        <!-- Floor (optional – if you want it visible) -->
        <div class="mb-3 w-100" style="max-width:450px;">
            <div class="d-flex align-items-center">
                <label class="control-label font-weight-bold mb-0 mr-3"
                       style="min-width:120px;">Requester's Floor</label>
                <input class="form-control" value="@Model.NumberOfFloors" readonly />
            </div>
        </div>

    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Ticket Information Panel -->
            <div class="panel panel-default mb-4 border rounded shadow-sm">
                <div class="panel-heading bg-light p-3 border-bottom rounded-top">
                    <h4 class="panel-title fw-bold text-center" style="color:darkcyan">Request Details </h4>
                </div>

                <div class="panel-body p-4">
                    <div class="row">

                        <!-- Left Column -->
                        <div class="col-md-6">

                            <!-- Title -->
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label asp-for="Title" class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px;"></label>
                                    <input asp-for="Title" class="form-control" />
                                </div>
                                <div style="margin-left:120px;">
                                    <span asp-validation-for="Title" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Category -->
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label asp-for="CategoryId" class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px;">Request Category</label>
                                    <select asp-for="CategoryId" class="form-control"
                                            asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
                                        <option value="">-- Select Request Category --</option>
                                    </select>
                                </div>
                                <div style="margin-left:120px;">
                                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                                </div>
                            </div>

                        </div>

                        <!-- Right Column -->
                        <div class="col-md-6">

                            <!-- Priority -->
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label asp-for="PriorityId" class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px;">Urgency</label>
                                    <select asp-for="PriorityId" class="form-control"
                                            asp-items="@(new SelectList(ViewBag.Priorities, "Id", "Name"))">
                                        <option value="">-- Select Urgency --</option>
                                    </select>
                                </div>
                                <div style="margin-left:120px;">
                                    <span asp-validation-for="PriorityId" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Attachments -->
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px;">Attachments</label>
                                    <input type="file" name="Attachments" multiple class="form-control" />
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Description (Full Width) -->
                    <div class="mb-3 w-100 mt-3">
                        <label asp-for="Description" class="control-label font-weight-bold"></label>
                        <textarea asp-for="Description" rows="5" class="form-control" style="max-width:100%;"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                </div>
            </div>

            <!-- Buttons -->
            <div class="form-group">
                <button type="submit" class="btn btn-primary px-4 me-2">Save</button>

                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="fas fa-arrow-left me-2"></i>Back to List
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <style>
        /* Uniform input field widths */
        .form-control {
            width: 100% !important;
        }

        .field-validation-error {
            display: block;
            margin-top: 5px;
        }

        select.form-control {
            height: 38px;
        }
    </style>
}
