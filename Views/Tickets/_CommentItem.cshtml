@model HelpdeskSystem.Models.TicketComment
@using Microsoft.AspNetCore.Identity
@inject UserManager<HelpdeskSystem.Models.ApplicationUser> UserManager

<div class="mb-3 p-2 border rounded">
    <div class="d-flex justify-content-between">
        <div>
            <strong>@Model.Author?.FullName</strong>
            <div class="small text-muted">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
        </div>
        <div>
            @if (User.Identity.IsAuthenticated)
            {
                var currentUserId = UserManager.GetUserId(User);
                bool isAdmin = User.IsInRole("Admin");
                if (Model.AuthorId == currentUserId || isAdmin)
                {
                    <form asp-action="DeleteComment" method="post" class="d-inline">
                        <input type="hidden" name="commentId" value="@Model.Id" />
                        <input type="hidden" name="ticketId" value="@Model.TicketId" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                }
            }
        </div>
    </div>
    <div class="mt-2">@Html.Raw(Html.Encode(Model.Body).Replace("\n", "<br/>"))</div>
</div>
