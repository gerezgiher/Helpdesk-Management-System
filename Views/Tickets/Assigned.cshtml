@functions {
    public string GetStatusBadge(string name)
    {
        return name switch
        {
            "Pending" => "bg-warning text-dark",
            "In Progress" => "bg-info text-dark",
            "Resolved" => "bg-success",
            "Rejected" => "bg-danger",
            "Closed" => "bg-secondary",
            _ => "bg-light text-dark"
        };
    }
}

