@model HelpdeskSystem.Models.Ticket
@* @{
    ViewData["Title"] = "Edit Ticket";
} *@

<h2 class="text-center mb-4 text-primary">Edit Request</h2>

<div class="container">
    <div class="card shadow-sm border-0 rounded-0">
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />

                <div class="row">

                    <!-- Left Column -->
                    <div class="col-md-6">

                        <!-- Title -->
                        <div class="mb-3 w-100" style="max-width:450px;">
                            <div class="d-flex align-items-center">
                                <label asp-for="Title" class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px;">Title</label>
                                <input asp-for="Title" class="form-control" />
                            </div>
                            <div style="margin-left:120px;">
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Category -->
                        <div class="mb-3 w-100" style="max-width:450px;">
                            <div class="d-flex align-items-center">
                                <label asp-for="CategoryId" class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px;">Category</label>
                                <select asp-for="CategoryId" class="form-control"
                                        asp-items="@(ViewBag.Categories != null ? new SelectList(ViewBag.Categories, "Id", "Name", Model.CategoryId) : new SelectList(Enumerable.Empty<object>()))">
                                    <option value="">-- Select Category --</option>
                                </select>
                            </div>
                            <div style="margin-left:120px;">
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>
                        </div>

                    </div>

                    <!-- Right Column -->
                    <div class="col-md-6">

                        <!-- Priority -->
                        <div class="mb-3 w-100" style="max-width:450px;">
                            <div class="d-flex align-items-center">
                                <label asp-for="PriorityId" class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px;">Priority</label>
                                <select asp-for="PriorityId" class="form-control"
                                        asp-items="@(ViewBag.Priorities != null ? new SelectList(ViewBag.Priorities, "Id", "Name", Model.PriorityId) : new SelectList(Enumerable.Empty<object>()))">
                                    <option value="">-- Select Priority --</option>
                                </select>
                            </div>
                            <div style="margin-left:120px;">
                                <span asp-validation-for="PriorityId" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Attachments (optional) -->
                    @*     Uncomment if you want to allow file uploads *@
                        <div class="mb-3 w-100" style="max-width:450px;">
                        <div class="d-flex align-items-center">
                        <label class="control-label font-weight-bold mb-0 mr-3" style="min-width:120px;">Attachments</label>
                        <input type="file" name="Attachments" multiple class="form-control" />
                        </div>
                        </div>
                       

                    </div>
                </div>

                <!-- Description (Full Width) -->
                <div class="mb-3 w-100 mt-3">
                    <label asp-for="Description" class="control-label font-weight-bold"></label>
                    <textarea asp-for="Description" rows="5" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- Buttons -->
                <div class="form-group text-center mt-4">
                <div class="form-group">
                    <button type="submit" class="btn btn-primary px-4 me-2">Update</button>

                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="fas fa-arrow-left me-2"></i>Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
