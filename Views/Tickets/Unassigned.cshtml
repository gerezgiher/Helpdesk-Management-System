@model IEnumerable<HelpdeskSystem.Models.Ticket>
@using Microsoft.AspNetCore.Identity
@inject UserManager<HelpdeskSystem.Models.ApplicationUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
    var roles = await UserManager.GetRolesAsync(currentUser);
    bool isAdmin = roles.Contains("Admin");

    // Only Admin sees unassigned tickets
    var ticketsToShow = isAdmin
        ? Model.Where(t => t.AssignedTo == null)   // Unassigned tickets
        : Enumerable.Empty<HelpdeskSystem.Models.Ticket>();
}

<h2>Unassigned Tickets</h2>

@if (isAdmin)
{
    <div class="alert alert-warning mb-3">
        <strong>@ticketsToShow.Count()</strong> unassigned tickets require attention
    </div>
}
else
{
    <div class="alert alert-info">
        You do not have permission to view unassigned tickets.
    </div>
}

@if (ticketsToShow.Any())
{
    <table id="unassignedTicketsTable" class="table table-striped table-bordered custom-datatable">
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Category</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Created By</th>
                <th>Created At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ticket in ticketsToShow)
            {
                <tr>
                    <td>#@ticket.Id</td>
                    <td>@ticket.Title</td>
                    <td>@ticket.Category?.Name</td>
                    <td>
                        <span class="badge @GetPriorityBadge(ticket.Priority?.Name)">
                            @ticket.Priority?.Name
                        </span>
                    </td>
                    <td>
                        <span class="badge @GetStatusBadge(ticket.Status?.Name)">
                            @ticket.Status?.Name
                        </span>
                    </td>
                    <td>@ticket.CreatedByEmployee?.FullName</td>
                    <td>@ticket.CreatedAt.ToString("MM/dd/yyyy HH:mm")</td>
                    <td>
                        <a class="btn btn-sm btn-primary" href="/Tickets/Details/@ticket.Id">View</a>
                        <a class="btn btn-sm btn-success" href="/Tickets/Edit/@ticket.Id">Edit</a>
                        <a class="btn btn-sm btn-danger" href="/Tickets/Delete/@ticket.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else if (isAdmin)
{
    <div class="alert alert-success">
        No unassigned tickets at the moment.
    </div>
}


@functions {
    public string GetStatusBadge(string name) => name switch
    {
        "Pending" => "bg-primary",
        "In Progress" => "bg-info text-dark",
        "Resolved" => "bg-success",
        "Closed" => "bg-dark",
        _ => "bg-secondary"
    };

    public string GetPriorityBadge(string name) => name switch
    {
        "Low" => "bg-success",
        "Medium" => "bg-warning text-dark",
        "High" => "bg-danger",
        "Critical" => "bg-dark text-light",
        _ => "bg-secondary"
    };
}
