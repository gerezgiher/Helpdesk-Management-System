@model IEnumerable<HelpdeskSystem.Models.Ticket>

<h2 class="text-center mb-4 text-primary">Ticket Queue</h2>
<table id="ticketQueueTable" class="table table-striped table-bordered custom-datatable">
    <thead>
        <tr>
            <th>Title</th>
            <th>Created By</th>
            <th>Created Date</th>
            <th>Assigned To</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var ticket in Model)
        {
            <tr>
                <td>@ticket.Title</td>

                <!-- Created By (safe) -->
                <td>@(ticket.CreatedByEmployee?.FullName ?? "Unknown")</td>

                <!-- Created At -->
                <td>@ticket.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>

                <!-- Assigned To (safe) -->
                <td>@(ticket.AssignedTo?.FullName ?? "Unassigned")</td>

                <!-- STATUS WITH BADGE -->
                <td>
                    <span class="badge @GetStatusBadge(ticket.Status?.Name)">
                        @ticket.Status?.Name
                    </span>
                </td>

                <td>
                    <a asp-controller="Tickets"
                       asp-action="Details"
                       asp-route-id="@ticket.Id"
                       class="btn btn-sm btn-primary">
                        View
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@functions {
    private string GetStatusBadge(string name) => name switch
    {
        "Pending" => "bg-primary",
        "In Progress" => "bg-info text-dark",
        "Resolved" => "bg-success",
        "Closed" => "bg-dark",
        _ => "bg-secondary"
    };
}
