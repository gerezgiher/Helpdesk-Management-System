@model IEnumerable<HelpdeskSystem.Models.Ticket>

<h2 class="text-center mb-4 text-primary">Ticket Status Report</h2>




<table id="ticketStatusTable" class="table table-striped table-bordered custom-datatable">
    <thead>
        <tr>
            <th>Title</th>
            <th>Created By</th>
            <th>Assigned To</th>
            <th>Status</th>
            <th>Priority</th>
            <th>Created At</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ticket in Model)
        {
            <tr>
                <td>@ticket.Title</td>
                <td>@ticket.CreatedByEmployee?.FullName</td>
                <td>@ticket.AssignedTo?.FullName </td>
                <td>@ticket.Status?.Name</td>
                <td>@ticket.Priority?.Name</td>
                <td>@ticket.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
            </tr>
        }
    </tbody>
</table>

