@model HelpdeskSystem.Models.Block

@{
    // ViewData["Title"] = "Create Block";
}

<hr />

<div class="row">
    <div class="col-md-12">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Block Information Panel -->
            <div class="panel panel-default mb-4 border rounded shadow-sm">
                <div class="panel-heading bg-light p-3 border-bottom rounded-top">
                    <h4 class="panel-title fw-bold text-center" style="color:darkcyan">Create Block</h4>
                </div>

                <div class="panel-body p-4">
                    <div class="row">

                        <!-- Left Column -->
                        <div class="col-md-6">

                            <!-- Block Name -->
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label asp-for="BlockName" class="control-label fw-bold mb-0 me-3" style="min-width:120px;"></label>
                                    <input asp-for="BlockName" class="form-control" />
                                </div>
                                <div style="margin-left:120px;">
                                    <span asp-validation-for="BlockName" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Block Code -->
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label asp-for="BlockCode" class="control-label fw-bold mb-0 me-3" style="min-width:120px;"></label>
                                    <input asp-for="BlockCode" class="form-control" />
                                </div>
                                <div style="margin-left:120px;">
                                    <span asp-validation-for="BlockCode" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Number of Floors -->
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label asp-for="NumberOfFloors" class="control-label fw-bold mb-0 me-3" style="min-width:120px;"></label>
                                    <input asp-for="NumberOfFloors" class="form-control" />
                                </div>
                                <div style="margin-left:120px;">
                                    <span asp-validation-for="NumberOfFloors" class="text-danger"></span>
                                </div>
                            </div>

                        </div>

                        <!-- Right Column -->
                        <div class="col-md-6">

                            <!-- Location -->
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label asp-for="Location" class="control-label fw-bold mb-0 me-3" style="min-width:120px;"></label>
                                    <input asp-for="Location" class="form-control" />
                                </div>
                                <div style="margin-left:120px;">
                                    <span asp-validation-for="Location" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Description -->
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label asp-for="Description" class="control-label fw-bold mb-0 me-3" style="min-width:120px;"></label>
                                    <input asp-for="Description" class="form-control" />
                                </div>
                                <div style="margin-left:120px;">
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Active Status -->
                      
                    <!-- Date Created and Date Modified (Full Width) -->
                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                                    <label class="control-label fw-bold mb-0 me-3" style="min-width:120px;">
                                        Date Created
                                    </label>
                                    <input class="form-control"
                                           value="@DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss")"
                                           readonly />
                                </div>
                            </div>


                            <div class="mb-3 w-100" style="max-width:450px;">
                                <div class="d-flex align-items-center">
                            <label asp-for="DateModified" class="control-label fw-bold mb-0 me-3" style="min-width:120px;"></label>
                            <input asp-for="DateModified" class="form-control" />
                        </div>
                        <div style="margin-left:120px;">
                            <span asp-validation-for="DateModified" class="text-danger"></span>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Buttons -->
            <div class="form-group">
                <button type="submit" class="btn btn-primary px-4 me-2">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="fas fa-arrow-left me-2"></i>Back to List
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <style>
        /* Uniform input field widths */
        .form-control {
            width: 100% !important;
        }

        .field-validation-error {
            display: block;
            margin-top: 5px;
        }

        select.form-control {
            height: 38px;
        }

        .form-check-input {
            margin-left: 0;
        }
    </style>
}
